<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!-- Lore Forever's load order, the only file LoreForever.toc lists: add, remove or reorder Lua files here, then
       /reload. Paths are relative to this folder. Bindings.xml isn't listed: the client reads it by itself. -->

  <!-- The lore data: Index.lua, the zone files, the search index and the word-piece vectors. Data\Data.xml is
       written by pipeline/lore/compile_lua.py. -->
  <Include file="Data\Data.xml"/>

  <Script file="Theme.lua"/>
  <Script file="Packs.lua"/>
  <Script file="Lang.lua"/>
  <Script file="Engine.lua"/>
  <Script file="Context.lua"/>
  <Script file="ModelRaces.lua"/>
  <Script file="Giver.lua"/>
  <Script file="Log.lua"/>
  <Script file="Journey.lua"/>
  <Script file="Capture.lua"/>
  <Script file="JourneyMap.lua"/>
  <Script file="JourneyRecord.lua"/>
  <Script file="Companion.lua"/>
  <Script file="Options.lua"/>
  <Script file="Voice.lua"/>
  <Script file="Hooks.lua"/>
  <Script file="Storyline.lua"/>
  <Script file="Notes.lua"/>
  <Script file="WhatsNew.lua"/>
  <Script file="UI.lua"/>
  <Script file="ClipReport.lua"/>
  <Script file="SelfTest.lua"/>
  <Script file="Core.lua"/>
</Ui>
